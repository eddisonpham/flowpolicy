# --- Agent kit: local-only green flag (never commit) ---
.claude/GREENLIGHT
.claude/settings.local.json

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- Editors ---
.idea/
.vscode/*
!.vscode/extensions.json

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# --- Envs (uv.lock and .python-version stay tracked) ---
.venv/
venv/
# The isolated env for the adapter-free control (`just lerobot-control`); derived, not source.
.venv-lerobot/
# Migrated checkpoint + rendered control videos: rebuilt by scripts/lerobot_migrate.py.
checkpoints/diffusion_pusht_migrated/
# Renders lerobot writes into each control output dir; the rows are the measurement, the mp4s are not.
# The `**/` rule covers `results/lerobot_control/videos/` as well, so it is not listed twice.
results/lerobot_control/**/videos/
# lerobot drops its per-run aggregate into whatever `--output_dir` it is handed. A run the docs quote
# gets a named copy next to the rows; the copies left inside output dirs are byproducts of a rerun.
results/lerobot_control/*/eval_info.json

# --- Tool caches / coverage ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
coverage.xml
htmlcov/

# --- Secrets ---
.env
.env.*
!.env.example

# --- Notebooks ---
.ipynb_checkpoints/

# --- Large / generated artifacts (anchored to repo root) ---
results/*.tmp
# In-flight rows from a crashed eval block (`rollout.evaluate` flushes here, appends on finish).
results/*.partial
# Run logs from long eval jobs: reproducible from the recipe, not a result.
results/logs/
# Scratch dirs from one-off probes (determinism checks, ad-hoc blocks): superseded once the finding is
# written into docs/, so they are working copies rather than rows. Root-anchored on purpose.
/tmp_*/
/data/
/logs/
/runs/
/wandb/
*.pt
*.pth
*.ckpt
*.safetensors
